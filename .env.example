# Copy to .env (gitignored) and adjust. deploy/run_endpoint.sh sources it;
# for a plain standalone run, export the variables or use a process manager.

# --- corpus ---
KB_ROOT=/data/knowledge-base          # the directory this studio works over
KB_LABEL='Knowledge Base'             # label shown at the top of the library tree
# STUDIO_LIBRARIES='[{"id":"scratch","label":"Scratch","indexRoot":"/gufi/scratch"}]'  # read-only indexes to mount beside the knowledge base (docs/LIBRARIES.md)
# STUDIO_SECTIONS='library,search,overview'   # which sections to show; unset shows all

# --- branding ---
APP_NAME='Studio'                     # product name in the header and browser tab
#APP_ICON=/path/to/icon.png           # header icon; falls back to a letter badge
#APP_FAVICON=/path/to/favicon.png     # browser tab icon; falls back to APP_ICON
#HELP_FILE=/path/to/HELP.md           # override the in-app help content
THEME=light                           # default theme: light | dark (users can toggle)

# --- chat identity (standalone; a platform JWT overrides these) ---
APP_USER_ID=user
APP_USERNAME=user
#APP_USER_NAME='Ada Lovelace'         # used in the chat greeting

# --- starter prompts shown on the empty chat (JSON array) ---
#SUGGESTED_PROMPTS='["What is in this knowledge base?","Summarize the most recently changed documents."]'

# --- models: any OpenAI-compatible backend ---
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=sk-...
# On ACTIVATE with an authenticated pw CLI, leave both unset (zero config).
#PW_ALLOCATION=MY-ALLOCATION          # enables org-provider models on the gateway

# --- indexing ---
SWEEP_INTERVAL_SEC=300                # background sync cadence; 0 disables
#STUDIO_SEARCH_ENGINE=gufi_vt        # search across libraries as one gufi_vt statement; default parallel
#ADE_VISION_MODEL=me:provider/model   # enables image captioning through the model endpoint

# --- platform identity (optional; running behind ACTIVATE) ---
#AUTH_JWKS_URL=https://platform.example/api/platform/keys
#AUTH_HEADER=x-pw-user-token          # header carrying the short-lived JWT
#AUTH_ISSUER=pw-session-proxy
#AUTH_AUDIENCE=session:<owner>/<sessionName>
#AUTH_REQUIRED=0                      # 1 rejects API requests without a valid token
#DISABLE_PERSONAL_KEYS=0              # 1 hard-disables per-user model keys (no vault, surface hidden)

# --- OpenID Connect sign-in (optional; docs/DEPLOY.md, Sign-in; needs the Go server) ---
#OIDC_ISSUER=https://platform.example.com/api/oidc
#OIDC_CLIENT_ID=pwapp_example
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=https://studio.example.org/api/auth/callback
#OIDC_POST_LOGOUT_REDIRECT_URI=https://studio.example.org/
#OIDC_SCOPES=openid profile email groups offline_access
#OIDC_REQUIRED=0                      # 1: every page and API request needs a signed-in user
#OIDC_END_SESSION=0                   # 1: sign-out also ends the provider's session
#OIDC_SESSION_MAX_AGE_SEC=43200       # how long a sign-in lasts
#AUTH_ACCOUNT_CLAIM=                  # claim naming the host account; unset assumes none
#AUTH_UID_CLAIM=                      # e.g. uidNumber, where the provider releases one
#AUTH_GID_CLAIM=                      # e.g. gidNumber
