# Copy to .env (gitignored) and adjust. deploy/run_endpoint.sh sources it;
# for a plain standalone run, export the variables or use a process manager.

# --- corpus ---
KB_ROOT=/data/knowledge-base          # the directory this studio works over
KB_LABEL='Knowledge Base'             # label shown at the top of the library tree

# --- branding ---
APP_NAME='Studio'                     # product name in the header and browser tab
#APP_ICON=/path/to/icon.png           # header icon; falls back to a letter badge
#HELP_FILE=/path/to/HELP.md           # override the in-app help content
THEME=light                           # default theme: light | dark (users can toggle)

# --- chat identity (standalone; a platform JWT overrides these) ---
APP_USER_ID=user
APP_USERNAME=user
#APP_USER_NAME='Ada Lovelace'         # used in the chat greeting

# --- starter prompts shown on the empty chat (JSON array) ---
#SUGGESTED_PROMPTS='["What is in this knowledge base?","Summarize the most recently changed documents."]'

# --- models: any OpenAI-compatible backend ---
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=sk-...
# On ACTIVATE with an authenticated pw CLI, leave both unset (zero config).
#PW_ALLOCATION=MY-ALLOCATION          # enables org-provider models on the gateway

# --- indexing ---
SWEEP_INTERVAL_SEC=300                # background sync cadence; 0 disables
#ADE_VISION_MODEL=me:provider/model   # enables image captioning through the model endpoint

# --- platform identity (optional; running behind ACTIVATE) ---
#AUTH_JWKS_URL=https://platform.example/oidc/jwks
#AUTH_HEADER=x-pw-access-token        # header carrying the short-lived JWT
#AUTH_ISSUER=
#AUTH_AUDIENCE=
#AUTH_REQUIRED=0                      # 1 rejects API requests without a valid token
