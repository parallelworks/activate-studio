{
  "name": "activate-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Knowledge base visualization and chat harness over a configurable corpus, served as an ACTIVATE session",
  "scripts": {
    "dev": "pnpm --parallel --filter @activate-studio/server --filter @activate-studio/web dev",
    "build": "pnpm --filter @activate-studio/web build && pnpm --filter @activate-studio/server build",
    "start": "node server/dist/main.js"
  },
  "packageManager": "pnpm@10.33.4",
  "license": "Apache-2.0"
}
