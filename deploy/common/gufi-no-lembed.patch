diff --git a/src/extensions.c b/src/extensions.c
index dff87dba..c80b8587 100644
--- a/src/extensions.c
+++ b/src/extensions.c
@@ -63,7 +63,9 @@ OF SUCH DAMAGE.
 
 
 #if HAVE_AI
+#if HAVE_LEMBED
 #include "sqlite-lembed.h"
+#endif
 #include "sqlite-vec.h"
 #endif
 
@@ -92,11 +94,13 @@ int augment_db(sqlite3 *db, const sqlite3_api_routines *pApi) {
         return 1;
     }
 
+    #if HAVE_LEMBED
     /* load the sqlite-lembed extension */
     if (sqlite3_lembed_init(db, &err, pApi) != SQLITE_OK) {
         sqlite_print_err_and_free(err, stderr, "Error: Could not initialize sqlite3-lembed: %s\n", err);
         return 1;
     }
+    #endif
     #else
     (void) err;
     (void) pApi;
