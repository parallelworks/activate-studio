# ============================================================================
# Studio -- multi-stage Singularity/Apptainer recipe
# (containerized-webapp-deployment pattern).
#
#   * Stage "build" compiles the web and server bundles, GUFI, and pulls the
#     embedding model, so the runtime image needs no compilers and no network.
#   * Stage "final" carries the production server, the built SPA, the
#     indexer, GUFI binaries, and the model.
#   * Runtime contract: binds 0.0.0.0:$PORT, serves HTTP at "/". The corpus
#     is bind-mounted and named by KB_ROOT; the index, settings, and
#     credential store live under DATA_DIR (bind-mount a writable directory,
#     never inside the image). Chat needs PW_API_KEY or a mounted pw
#     credential; everything else works without it. INDEX_ON_START=1 builds
#     or refreshes the index before serving.
#
#   The image exists because host environments vary in ways that break a
#   from-source deploy: an old default python3 beside a newer one, a stale
#   corepack shim, an assembler that rejects the CPU's newest instructions,
#   install paths that assume root. Everything the app compiles against is
#   pinned here instead of discovered on the node, and nothing in the image
#   requires privilege at run time.
#
# Build:   apptainer build studio.sif deploy/app.def   (run from the repo root)
#          Stale Docker Hub tokens in ~/.docker/config.json make the base
#          image pull fail as unauthorized instead of falling back to
#          anonymous; build with a clean HOME if that happens.
# Test:    apptainer run --env PORT=8080 --env KB_ROOT=/kb --env DATA_DIR=/data \
#              --bind /path/to/corpus:/kb --bind /path/to/state:/data studio.sif
# ============================================================================

Bootstrap: docker
From: node:20-bookworm
Stage: build

%files
    . /opt/src

%post
    export DEBIAN_FRONTEND=noninteractive
    # GUFI's cmake requires these executables at configure time (column
    # ships in bsdextrautils on Debian; setfattr/getfattr in attr).
    apt-get update && apt-get install -y --no-install-recommends \
        cmake make gcc g++ pkg-config zlib1g-dev libsqlite3-dev git curl ca-certificates \
        bsdextrautils attr diffutils patch gawk patchelf
    # npm, not corepack: corepack's loader crashes on some pnpm/Node
    # pairings and leaves broken shims behind.
    npm install -g pnpm@10
    cd /opt/src
    rm -rf node_modules web/node_modules server/node_modules index deploy/.cache
    pnpm install --frozen-lockfile
    pnpm build
    pnpm --filter @activate-studio/server --prod deploy --legacy /opt/app/server
    # pnpm's virtual store keeps a workspace self-link that escapes to
    # /opt/src, and the stage copy refuses a symlink leaving the tree.
    # Nothing outside /opt/app is needed at run time, so drop those.
    find /opt/app -type l | while read -r l; do
        case "$(readlink -f "$l" || true)" in
            /opt/app/*) ;;
            *) rm -f "$l" ;;
        esac
    done
    mkdir -p /opt/app/web
    cp -r web/dist /opt/app/web/dist
    cp -r indexer /opt/app/indexer
    cp -r docs /opt/app/docs
    cp -r extensions-starter /opt/app/extensions-starter
    mkdir -p /opt/app/index/models
    curl -fsSL -o /opt/app/index/models/minilm384.gguf \
        'https://huggingface.co/asg017/sqlite-lembed-model-examples/resolve/main/all-MiniLM-L6-v2/all-MiniLM-L6-v2.e4ce9877.q8_0.gguf'
    git clone --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/mar-file-system/GUFI /opt/gufi-src
    # GUFI's cmake derives its version from git describe, which a shallow
    # tagless clone cannot answer.
    git -C /opt/gufi-src -c user.name=build -c user.email=build@localhost \
        tag -a build-snapshot -m "build snapshot"
    # llama.cpp (vendored via sqlite-lembed) defaults to -march=native, which
    # bakes in host instructions the target CPU or assembler may reject; the
    # image must run anywhere.
    sed -i 's/-DGGML_CCACHE=Off/-DGGML_CCACHE=Off -DGGML_NATIVE=Off/' \
        /opt/gufi-src/contrib/deps/sqlite-lembed.sh
    mkdir -p /opt/gufi-src/build
    cd /opt/gufi-src/build
    cmake .. -DCMAKE_INSTALL_PREFIX=/opt/gufi -DCMAKE_BUILD_TYPE=Release \
        -DSERVER_CONFIG=/opt/gufi/etc/server -DCLIENT_CONFIG=/opt/gufi/etc/client \
        -DBASH_COMPLETION=Off
    make -j "$(nproc)"
    make install
    # GUFI links its AI tooling against libraries under the build tree's
    # dependency prefix (llama.cpp and its own sqlite build), which the
    # runtime stage does not carry; place them beside the binaries and give
    # the binaries an rpath to match. An LD_LIBRARY_PATH would do the same
    # job far too broadly: GUFI's sqlite lacks symbols CPython's sqlite3
    # module needs, so exporting it breaks every indexer script.
    cp -a /opt/gufi-src/build/deps/*/lib/*.so* /opt/gufi/lib/ 2>/dev/null || true
    for b in /opt/gufi/bin/*; do
        [ -f "$b" ] && [ -x "$b" ] || continue
        patchelf --set-rpath '$ORIGIN/../lib' "$b" 2>/dev/null || true
    done
    # The libraries need a path of their own: a RUNPATH covers an object's
    # direct dependencies only, so without this the binary finds libllama
    # and libllama then fails to find libggml.
    for l in /opt/gufi/lib/*.so*; do
        [ -f "$l" ] || continue
        patchelf --set-rpath '$ORIGIN' "$l" 2>/dev/null || true
    done

# ---------------------------------------------------------------------------
Bootstrap: docker
From: node:20-bookworm-slim
Stage: final

%files from build
    /opt/app /app
    /opt/gufi /opt/gufi

%post
    export DEBIAN_FRONTEND=noninteractive
    # bookworm's python3 is 3.11, which satisfies the indexer's 3.10+ syntax.
    apt-get update && apt-get install -y --no-install-recommends \
        python3 attr poppler-utils tesseract-ocr curl ca-certificates \
        && rm -rf /var/lib/apt/lists/*
    cat > /app/start.sh << 'START'
#!/bin/sh
# The index lives on the bind-mounted data directory, never in the image;
# the embedding model is seeded there on first run.
set -e
mkdir -p "$INDEX_BASE/models"
[ -f "$INDEX_BASE/models/minilm384.gguf" ] || \
    cp /app/index/models/minilm384.gguf "$INDEX_BASE/models/" 2>/dev/null || true
# INDEX_ON_START=1 builds or refreshes the index before serving.
if [ "${INDEX_ON_START:-0}" = "1" ] && [ -x "$GUFI_BIN/gufi_dir2index" ]; then
    PROJECT_ROOT=/app bash /app/indexer/reindex.sh || \
        echo "WARNING: index build failed; serving the filesystem"
fi
exec node /app/server/dist/main.js
START
    chmod +x /app/start.sh

%environment
    export NODE_ENV=production
    export HOST=0.0.0.0
    export GUFI_BIN=/opt/gufi/bin
    export PYTHON_BIN=python3
    export KB_ROOT="${KB_ROOT:-/kb}"
    export INDEX_BASE="${DATA_DIR:-/data}/index"

%startscript
    exec /app/start.sh

%runscript
    exec /app/start.sh

%labels
    org.parallelworks.app studio
    org.parallelworks.pattern generic-interactive-app
    org.parallelworks.contract "PORT + KB_ROOT + DATA_DIR env in, HTTP at / out"
