{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACTIVATE Studio",
  "version": "0.1.0",
  "identifier": "com.parallelworks.activate-studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "publisher": "Parallel Works",
    "category": "Productivity",
    "shortDescription": "ACTIVATE Studio desktop shell (spike)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
